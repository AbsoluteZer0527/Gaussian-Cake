#version 430
// Pass 2, naive surface nets (Gibson 1998): every cell the surface passes
// through gets one vertex, at the mean of its edge crossings. One thread per
// cell; the vertex slot comes from an atomic counter.
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

const ivec3 kCorner[8] = ivec3[8](
    ivec3(0,0,0), ivec3(1,0,0), ivec3(0,1,0), ivec3(1,1,0),
    ivec3(0,0,1), ivec3(1,0,1), ivec3(0,1,1), ivec3(1,1,1));
const ivec2 kEdge[12] = ivec2[12](
    ivec2(0,1), ivec2(2,3), ivec2(4,5), ivec2(6,7), ivec2(0,2), ivec2(1,3),
    ivec2(4,6), ivec2(5,7), ivec2(0,4), ivec2(1,5), ivec2(2,6), ivec2(3,7));

void main() {
    ivec3 c = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(c, ivec3(n - 1)))) return;
    uint id = CellId(c);

    float val[8];
    int inside = 0;
    for (int q = 0; q < 8; ++q) {
        val[q] = field[PointId(c + kCorner[q])];
        if (val[q] < 0.0) ++inside;
    }
    if (inside == 0 || inside == 8) { cellVert[id] = -1; return; }

    vec3 sum = vec3(0.0);
    int cnt = 0;
    for (int e = 0; e < 12; ++e) {
        float a = val[kEdge[e].x], b = val[kEdge[e].y];
        if ((a < 0.0) == (b < 0.0)) continue;
        sum += mix(vec3(kCorner[kEdge[e].x]), vec3(kCorner[kEdge[e].y]), a / (a - b));
        ++cnt;
    }
    vec3 pos = lo + h * (vec3(c) + sum / float(cnt));

    uint v = atomicAdd(vertCount, 1u);   // take a ticket
    if (v >= vertCap) { overflow = 1u; cellVert[id] = -1; return; }

    // The field grows fastest straight out of the surface, so its gradient
    // is the outward normal (closed form, see PhiGrad).
    vec3 grad = PhiGrad(pos);
    float len = length(grad);
    vec3 nrm = (len > 1e-12) ? grad / len : vec3(0.0, 1.0, 0.0);

    verts[v] = Vertex(vec4(pos, 1.0), vec4(nrm, 0.0));
    cellVert[id] = int(v);
}
