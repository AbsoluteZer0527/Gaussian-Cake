#version 430
// One thread per splat: interpolate it at the current time (the same math as
// the CPU loop in Window::idleCallback), then project it to a 2D screen-space
// Gaussian (the same EWA math as splat.vert) and write a depth sort key.
// Doing the projection here, once per splat, means the vertex shader only
// has to place the quad's four corners.
layout(local_size_x = 256) in;

struct SplatKeyframes {
    vec4 meanA, meanB;           // xyz
    vec4 rotA, rotB;             // quaternion (x, y, z, w)
    vec4 logScaleA, logScaleB;   // xyz = log(scale), w = opacity
    vec4 colorA, colorB;         // rgb; colorA.w = heat-wave delay
    vec4 smoothDisp;             // xyz: neighbour-averaged displacement, w: halfway stretch
};
struct Prepared {
    vec4 clip;                   // clip-space center
    vec4 conicRadius;            // inverse 2D covariance (xx, xy, yy), quad radius in pixels (0 = culled)
    vec4 color;                  // rgba
};

layout(std430, binding = 0) readonly  buffer Keyframes { SplatKeyframes keyframes[]; };
layout(std430, binding = 1) writeonly buffer Prep      { Prepared prep[]; };
layout(std430, binding = 2) writeonly buffer SortKeys  { uint sortKeys[]; };
layout(std430, binding = 3) writeonly buffer SortVals  { uint sortVals[]; };

// View-dependent colour (3DGS spherical harmonics, degrees 1..3): per splat,
// 23 uints for the start and 23 for the end, each two half floats, in the
// order coefficient 1 r g b, coefficient 2 r g b, ... Bound only for captures.
layout(std430, binding = 5) readonly buffer ShCoeffs { uint shWords[]; };
const uint kShWords = 23u;

uniform uint  count;
uniform vec3  camPos;
uniform int   shDegree;   // 0 = no view-dependent colour (or no buffer bound)
uniform float e;          // eased time
uniform float sizeMul;    // scales every splat (a capture shown at rest)
uniform float stretchOn;  // 1 = apply the per-splat area stretch, 0 = ignore it
uniform float wave;       // heat-wave width, 0 = off (all splats share e)
uniform float cohesionExp;   // cohesion weight g = e^cohesionExp
uniform float midGrow;    // mid-flight size boost: grow = 1 + midGrow 4e(1-e)
uniform int   hasSmooth;
uniform mat4  view;
uniform mat4  proj;
uniform vec2  viewport;   // pixels

// glm::slerp: shortest path, plain lerp when the two are nearly equal
vec4 Slerp(vec4 x, vec4 y, float a) {
    float c = dot(x, y);
    if (c < 0.0) { y = -y; c = -c; }
    if (c > 1.0 - 1.1920929e-7) return mix(x, y, a);
    float angle = acos(c);
    return (sin((1.0 - a) * angle) * x + sin(a * angle) * y) / sin(angle);
}

// glm::mat3_cast for q = (x, y, z, w)
mat3 QuatToMat(vec4 q) {
    float xx = q.x * q.x, yy = q.y * q.y, zz = q.z * q.z;
    float xy = q.x * q.y, xz = q.x * q.z, yz = q.y * q.z;
    float wx = q.w * q.x, wy = q.w * q.y, wz = q.w * q.z;
    return mat3(1.0 - 2.0 * (yy + zz), 2.0 * (xy + wz),       2.0 * (xz - wy),
                2.0 * (xy - wz),       1.0 - 2.0 * (xx + zz), 2.0 * (yz + wx),
                2.0 * (xz + wy),       2.0 * (yz - wx),       1.0 - 2.0 * (xx + yy));
}

// Sum of Y_k(d) sh_k, k = 1..15 (SphericalHarmonics.h, same constants)
vec3 EvalSH(uint base, vec3 d) {
    float c[46];
    for (uint w = 0u; w < kShWords; ++w) {
        vec2 h = unpackHalf2x16(shWords[base + w]);
        c[2u * w] = h.x;
        c[2u * w + 1u] = h.y;
    }
    #define COEF(k) vec3(c[3 * (k)], c[3 * (k) + 1], c[3 * (k) + 2])
    float x = d.x, y = d.y, z = d.z;
    vec3 r = 0.4886025119029199 * (-y * COEF(0) + z * COEF(1) - x * COEF(2));
    if (shDegree >= 2) {
        float xx = x * x, yy = y * y, zz = z * z;
        r += 1.0925484305920792 * x * y * COEF(3)
           - 1.0925484305920792 * y * z * COEF(4)
           + 0.31539156525252005 * (2.0 * zz - xx - yy) * COEF(5)
           - 1.0925484305920792 * x * z * COEF(6)
           + 0.5462742152960396 * (xx - yy) * COEF(7);
        if (shDegree >= 3) {
            r += -0.5900435899266435 * y * (3.0 * xx - yy) * COEF(8)
               + 2.890611442640554 * x * y * z * COEF(9)
               - 0.4570457994644658 * y * (4.0 * zz - xx - yy) * COEF(10)
               + 0.3731763325901154 * z * (2.0 * zz - 3.0 * xx - 3.0 * yy) * COEF(11)
               - 0.4570457994644658 * x * (4.0 * zz - xx - yy) * COEF(12)
               + 1.445305721320277 * z * (xx - yy) * COEF(13)
               - 0.5900435899266435 * x * (xx - 3.0 * yy) * COEF(14);
        }
    }
    #undef COEF
    return r;
}

// Float -> uint whose integer order is the float's order (flip all bits of
// negatives, only the sign bit of positives).
uint SortableBits(float f) {
    uint u = floatBitsToUint(f);
    return u ^ (((u >> 31) != 0u) ? 0xFFFFFFFFu : 0x80000000u);
}

void Cull(uint i) {
    prep[i] = Prepared(vec4(0.0, 0.0, 2.0, 1.0), vec4(0.0), vec4(0.0));
    sortKeys[i] = 0xFFFFFFFFu;   // sorts last
    sortVals[i] = i;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= count) return;
    SplatKeyframes k = keyframes[i];

    // ---- this splat's clock (SplatHeat.cpp SplatClockAt, line for line) ----
    float ei = e;
    if (wave > 0.0) {
        float inside = clamp(e, 0.0, 1.0);
        float local = (inside - wave * k.colorA.w) / (1.0 - wave);
        ei = clamp(local, 0.0, 1.0) + (e - inside);   // keeps easing overshoot
    }
    float gi = pow(max(ei, 0.0), cohesionExp);
    float tc = clamp(ei, 0.0, 1.0);
    float bump = 4.0 * tc * (1.0 - tc);
    float growi = sizeMul * (1.0 + midGrow * bump);

    // ---- interpolate (Window::idleCallback) ----
    vec3 a = k.meanA.xyz, b = k.meanB.xyz;
    vec3 mean;
    if (hasSmooth != 0) {
        vec3 sd = k.smoothDisp.xyz;
        mean = a + ei * sd + gi * ((b - a) - sd);
    } else {
        mean = mix(a, b, ei);
    }
    vec4  rot     = Slerp(k.rotA, k.rotB, ei);
    vec3  scale   = growi * exp(mix(k.logScaleA.xyz, k.logScaleB.xyz, ei));
    scale.xy     *= pow(k.smoothDisp.w, stretchOn * bump);   // z is the thin axis
    float opacity = mix(k.logScaleA.w, k.logScaleB.w, ei);
    mat3  Rt      = QuatToMat(rot);

    // Colour. A capture's view-dependent colour turns with its splat: each
    // end's SH is read in the direction that, in that end's own frame, points
    // where the view direction points in the current frame (R_end R_t^T d).
    // Exact at both ends, and for every degree.
    vec3 colorA = k.colorA.rgb, colorB = k.colorB.rgb;
    if (shDegree > 0) {
        vec3 d = normalize(mean - camPos);
        vec3 local = transpose(Rt) * d;
        colorA = max(colorA + EvalSH(i * 2u * kShWords, QuatToMat(k.rotA) * local), 0.0);
        colorB = max(colorB + EvalSH((i * 2u + 1u) * kShWords, QuatToMat(k.rotB) * local), 0.0);
    }
    vec3 color = clamp(mix(colorA, colorB, ei), 0.0, 1.0);

    // Sigma = (R S)(R S)^T
    mat3 M = Rt * mat3(scale.x, 0.0, 0.0, 0.0, scale.y, 0.0, 0.0, 0.0, scale.z);
    mat3 Sigma = M * transpose(M);

    // ---- project (splat.vert) ----
    vec4 tv = view * vec4(mean, 1.0);
    float tz = -tv.z;
    if (tz < 0.05 || opacity < 1.0 / 255.0) { Cull(i); return; }

    float fx = proj[0][0] * viewport.x * 0.5;
    float fy = proj[1][1] * viewport.y * 0.5;
    float limX = 1.3 / proj[0][0];
    float limY = 1.3 / proj[1][1];
    float tx = clamp(tv.x / tz, -limX, limX) * tz;
    float ty = clamp(tv.y / tz, -limY, limY) * tz;
    mat3 J = mat3(fx / tz, 0.0, 0.0,
                  0.0, fy / tz, 0.0,
                  fx * tx / (tz * tz), fy * ty / (tz * tz), 0.0);
    mat3 T = J * mat3(view);
    mat3 cov2d = T * Sigma * transpose(T);

    float ca = cov2d[0][0] + 0.3;
    float cb = cov2d[0][1];
    float cc = cov2d[1][1] + 0.3;
    float det = ca * cc - cb * cb;
    if (det <= 0.0) { Cull(i); return; }

    float mid = 0.5 * (ca + cc);
    float lambda1 = mid + sqrt(max(0.1, mid * mid - det));
    float radius = 3.0 * sqrt(lambda1);

    vec4 clip = proj * tv;
    // off screen, even counting the quad's size
    vec2 ndc = clip.xy / clip.w;
    vec2 rNdc = 2.0 * radius / viewport;
    if (any(greaterThan(abs(ndc), vec2(1.0) + rNdc))) { Cull(i); return; }

    prep[i] = Prepared(clip, vec4(vec3(cc, -cb, ca) / det, radius), vec4(color, opacity));
    sortKeys[i] = SortableBits(tv.z);   // most negative z = farthest = drawn first
    sortVals[i] = i;
}
